<UserControl x:Class="AssetEditor.Views.MenuBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:local="clr-namespace:AssetEditor.Views" 
             xmlns:viewModels="clr-namespace:AssetEditor.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Open Recent sits in a different place depending on whether direct pack editing is on -->
        <Style x:Key="RecentPacksMenuItem" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="ItemsSource" Value="{Binding MenuBar.RecentPackFiles}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <HierarchicalDataTemplate DataType="{x:Type viewModels:RecentPackFileItem}" ItemsSource="{Binding Path=MenuItems}">
                        <TextBlock Text="{Binding Header}"/>
                    </HierarchicalDataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Menu VerticalAlignment="Center"
              DockPanel.Dock="Left"
              Background="Transparent">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}"/>
            </Menu.Resources>

            <MenuItem Header="{loc:Loc MenuBar.File}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- With direct pack editing on, the pack items lead like a standard File menu; the project items follow -->
                <MenuItem Header="{loc:Loc MenuBar.File.NewPackDirect}" Command="{Binding MenuBar.CreateNewPackCommand}"
                          Visibility="{Binding MenuBar.IsDirectPackEditingEnabled, Converter={StaticResource BoolToVisibility}}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.OpenPackDirect}" Command="{Binding MenuBar.OpenPackForEditingCommand}"
                          Visibility="{Binding MenuBar.IsDirectPackEditingEnabled, Converter={StaticResource BoolToVisibility}}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.OpenRecentPacks}" Style="{StaticResource RecentPacksMenuItem}"
                          Visibility="{Binding MenuBar.IsDirectPackEditingEnabled, Converter={StaticResource BoolToVisibility}}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.SaveActive}" Command="{Binding MenuBar.SaveActivePackCommand}"
                          Visibility="{Binding MenuBar.IsDirectPackEditingEnabled, Converter={StaticResource BoolToVisibility}}"/>
                <Separator Visibility="{Binding MenuBar.IsDirectPackEditingEnabled, Converter={StaticResource BoolToVisibility}}"/>

                <MenuItem Header="{loc:Loc MenuBar.File.NewPack}" Command="{Binding MenuBar.CreateNewProjectCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.ImportPackAsProject}" Command="{Binding MenuBar.ImportPackAsProjectCommand}"/>




                <MenuItem Header="{loc:Loc MenuBar.File.OpenProjectFolder}" Command="{Binding MenuBar.OpenProjectFolderCommand}"/>
                <Separator Visibility="{Binding MenuBar.IsDirectPackEditingEnabled, Converter={StaticResource BoolToVisibility}}"/>

                <MenuItem Header="{loc:Loc MenuBar.File.ImportReferencePack}" Command="{Binding MenuBar.ImportReferencePackCommand}"/>

                <MenuItem Header="{loc:Loc MenuBar.File.OpenGamePacks}">
                    <MenuItem Header="{loc:Loc MenuBar.File.GameAttila}" Command="{Binding MenuBar.OpenAttilaPacksCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.File.GameRomeRemastered}" Command="{Binding MenuBar.OpenRomeRemasteredPacksCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.File.GameThreeKingdoms}" Command="{Binding MenuBar.OpenThreeKingdomsPacksCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.File.GameWarhammer2}" Command="{Binding MenuBar.OpenWarhammer2PacksCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.File.GameWarhammer3}" Command="{Binding MenuBar.OpenWarhammer3PacksCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.File.GameTroy}" Command="{Binding MenuBar.OpenTroyPacksCommand}"/>
                </MenuItem>
                
                <MenuItem Header="{loc:Loc MenuBar.File.OpenRecentPacks}" Style="{StaticResource RecentPacksMenuItem}"
                          Visibility="{Binding MenuBar.IsDirectPackEditingDisabled, Converter={StaticResource BoolToVisibility}}"/>

                <Separator Visibility="{Binding MenuBar.IsDirectPackEditingDisabled, Converter={StaticResource BoolToVisibility}}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.SaveActivePack}" Command="{Binding MenuBar.SaveActivePackCommand}"
                          Visibility="{Binding MenuBar.IsDirectPackEditingDisabled, Converter={StaticResource BoolToVisibility}}"/>
                <Separator/>


                <MenuItem Header="{loc:Loc MenuBar.File.NewAnimPackWh3}" Command="{Binding MenuBar.CreateAnimPackWarhammer3Command}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.NewAnimPack3K}" Command="{Binding MenuBar.CreateAnimPack3kCommand}"/>

                <Separator/>
                <MenuItem Header="{loc:Loc MenuBar.File.Settings}" Command="{Binding MenuBar.OpenSettingsWindowCommand}"/>

                <Separator/>

                <MenuItem Header="{loc:Loc MenuBar.File.OpenAssetEditorFolder}" Command="{Binding MenuBar.OpenAssetEditorFolderCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.File.ClearAssetEditorFolder}" Command="{Binding MenuBar.ClearAssetEditorFolderCommand}"/>

                <Separator/>

                <MenuItem Header="{loc:Loc MenuBar.File.Exit}" Click="ExitMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{loc:Loc MenuBar.View}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="{loc:Loc MenuBar.View.TogglePackFileExplorer}" Command="{Binding MenuBar.TogglePackFileExplorerCommand}"/>
            </MenuItem>

            <MenuItem Header="{loc:Loc MenuBar.Tools}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True" ItemsSource="{Binding MenuBar.Editors}">

                <!-- Section headers are a rule plus a small title, inline in this same dropdown. They
                     can't be clicked or focused, so keyboard navigation skips straight past them. -->
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSectionHeader}" Value="False">
                                <Setter Property="Command" Value="{Binding OpenEditorCommand}" />
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                            <StackPanel Margin="0,3,0,0">
                                                <Separator Style="{DynamicResource {x:Static MenuItem.SeparatorStyleKey}}" />
                                                <TextBlock Text="{Binding Title}" FontSize="10" Margin="34,0,8,2"
                                                           Foreground="{DynamicResource ABrush.Foreground.Disabled}" />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>

                <MenuItem.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:EditorShortcutViewModel}">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </MenuItem.ItemTemplate>

            </MenuItem>

            <MenuItem Header="{loc:Loc MenuBar.Reports}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="{loc:Loc MenuBar.Reports.Rmv2}" Command="{Binding MenuBar.GenerateRmv2ReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.Bmd}" Command="{Binding MenuBar.GenerateBmdReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.MetaData}" Command="{Binding MenuBar.GenerateMetaDataReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.FileList}" Command="{Binding MenuBar.GenerateFileListReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.MetaJsons}" Command="{Binding MenuBar.GenerateMetaDataJsonsReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.Materials}" Command="{Binding MenuBar.GenerateMaterialReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.DialogueEventsStateGroups}" Command="{Binding MenuBar.GenerateDialogueEventInfoPrinterReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.DialogueEventNames}" Command="{Binding MenuBar.GenerateDialogueEventAndEventNamePrinterReportCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.DatDump}" Command="{Binding MenuBar.GenerateDatDumperReportCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.Search}" Command="{Binding MenuBar.SearchCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc MenuBar.Reports.TouchedFiles}">
                    <MenuItem Header="{loc:Loc MenuBar.Reports.TouchedFiles.StartRecorder}" Command="{Binding MenuBar.TouchedFileRecorderStartCommand }"/>
                    <MenuItem Header="{loc:Loc MenuBar.Reports.TouchedFiles.PrintFiles}" Command="{Binding MenuBar.TouchedFileRecorderPrintCommand }"/>
                    <MenuItem Header="{loc:Loc MenuBar.Reports.TouchedFiles.ExtractToPack}" Command="{Binding MenuBar.TouchedFileRecorderExtractCommand }"/>
                    <MenuItem Header="{loc:Loc MenuBar.Reports.TouchedFiles.StopRecorder}" Command="{Binding MenuBar.TouchedFileRecorderStopCommand }"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{loc:Loc MenuBar.Debug}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True"
                      Visibility="{Binding MenuBar.IsDebuggerAttached, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="{loc:Loc MenuBar.Debug.ClearConsole}" Command="{Binding MenuBar.ClearConsoleCommand}" />
                <MenuItem Header="{loc:Loc MenuBar.Debug.PrintScopes}" Command="{Binding MenuBar.PrintScopeCommand}" />
                <MenuItem Header="{loc:Loc MenuBar.Debug.PrintTrackedGraphicsResources}" Command="{Binding MenuBar.PrintTrackedGraphicsResourcesCommand}" />
            </MenuItem>

            <MenuItem Header="{loc:Loc MenuBar.Help}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="{loc:Loc MenuBar.Help.AssetEditorHelp}" Command="{Binding MenuBar.OpenHelpCommand}"/>
                <MenuItem Header="{loc:Loc MenuBar.Help.ModdingWiki}" Command="{Binding MenuBar.OpenModdingWikiCommand}"/>
                <Separator/>

                <MenuItem Header="{loc:Loc MenuBar.Help.VideoTutorials}">
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.Basics1}" Command="{Binding MenuBar.OpenAssetEdBasic0TutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.Basics2}" Command="{Binding MenuBar.OpenAssetEdBasic1TutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.SkragReskin}" Command="{Binding MenuBar.OpenSkragTutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.TzarGuardWithGun}" Command="{Binding MenuBar.OpenTzarGuardTutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.KostalynReskin}" Command="{Binding MenuBar.OpenKostalynTutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.RecolouringModels}" Command="{Binding MenuBar.OpenRecolouringModelsTutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.AnimationBasics}" Command="{Binding MenuBar.OpenAnimationBasicsTutorialCommand}"/>
                    <MenuItem Header="{loc:Loc MenuBar.Help.Tutorial.AnimatedPropsCustomPacks}" Command="{Binding MenuBar.OpenAnimatedPropTutorialCommand}"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="{loc:Loc MenuBar.Help.Discord}" Command="{Binding MenuBar.OpenDiscordCommand}"/>
            </MenuItem>
        </Menu>
    </DockPanel>
</UserControl>