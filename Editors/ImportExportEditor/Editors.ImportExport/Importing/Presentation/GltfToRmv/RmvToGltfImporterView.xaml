<UserControl x:Class="Editors.ImportExport.Importing.Presentation.RmvToGltf.RmvToGltfImporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             VerticalAlignment="Stretch">

    <Grid VerticalAlignment="Stretch" Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.NewSkeletonName}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <TextBox Grid.Row="0" Grid.Column="2" Width="240" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Text="{Binding NewSkeletonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.NewSkeletonName}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.SourceForwardDirection}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <ComboBox Grid.Row="1" Grid.Column="2" Width="240" HorizontalAlignment="Left" VerticalAlignment="Center"
                  ItemsSource="{Binding SourceForwardDirections}"
                  DisplayMemberPath="Key"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SourceForwardDirection, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.SourceForwardDirection}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.AutoScaleHumanoid}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsChecked="{Binding AutoScaleHumanoid, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.AutoScaleHumanoid}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.ImportMeshes}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsChecked="{Binding ImportMeshes, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.ImportMeshes}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.ImportMaterials}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsChecked="{Binding ImportMaterials, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.ImportMaterials}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.ConvertMaterialMap}"/>
        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsEnabled="{Binding ImportMaterials}"
                  IsChecked="{Binding ConvertFromBlenderMaterialMap, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.ConvertMaterialMap}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.ConvertNormalMap}"/>
        <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsEnabled="{Binding ImportMaterials}"
                  IsChecked="{Binding ConvertNormalTextureToOrange, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.ConvertNormalMap}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.ImportAnimations}"/>
        <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="7" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsChecked="{Binding ImportAnimations, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.ImportAnimations}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.AutoDetectAnimationFrameRate}"/>
        <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <CheckBox Grid.Row="8" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  IsEnabled="{Binding ImportAnimations}"
                  IsChecked="{Binding AutoDetectAnimationKeysPerSecond, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.AutoDetectAnimationFrameRate}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Text="{loc:Loc RmvToGltfImporter.KeySamplesPerSecond}"/>
        <TextBlock Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" Text=" : "/>
        <TextBox Grid.Row="9" Grid.Column="2" Width="60" HorizontalAlignment="Left" VerticalAlignment="Center"
                 IsEnabled="{Binding CanEditAnimationKeysPerSecond}"
                 Text="{Binding AnimationKeysPerSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc RmvToGltfImporter.Tooltips.KeySamplesPerSecond}"/>
    </Grid>
</UserControl>
