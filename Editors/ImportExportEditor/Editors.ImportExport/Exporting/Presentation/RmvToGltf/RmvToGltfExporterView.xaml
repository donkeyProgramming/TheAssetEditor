<UserControl x:Class="Editors.ImportExport.Exporting.Presentation.RmvToGltf.RmvToGltfExporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Editors.ImportExport.Exporting.Presentation.RmvToGltf"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc RmvToGltfExporter.ExportTextures}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text=" : " VerticalAlignment="Center"/>
        <CheckBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left"  IsChecked="{Binding ExportTextures, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc RmvToGltfExporter.ConvertMaterial}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text=" : " VerticalAlignment="Center"/>
        <CheckBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" 
                  IsEnabled="{Binding ExportTextures, UpdateSourceTrigger=PropertyChanged}" 
                  IsChecked="{Binding ConvertMaterialTextureToBlender, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfExporter.Tooltips.ConvertMaterial}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc RmvToGltfExporter.ConvertNormal}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text=" : " VerticalAlignment="Center"/>
        <CheckBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" 
                  IsEnabled="{Binding ExportTextures, UpdateSourceTrigger=PropertyChanged}" 
                  IsChecked="{Binding ConvertNormalTextureToBlue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                  ToolTip="{loc:Loc RmvToGltfExporter.Tooltips.ConvertNormal}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc RmvToGltfExporter.ExportAnimations}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text=" : " VerticalAlignment="Center"/>
        <CheckBox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" IsChecked="{Binding ExportAnimations, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Text="{Binding SkeletonStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="{Binding ResolutionStatus}" TextWrapping="Wrap" Foreground="DarkOrange"/>

        <DockPanel Grid.Row="6" Grid.ColumnSpan="4" LastChildFill="False">
            <TextBlock Text="{loc:Loc RmvToGltfExporter.Animations}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AnimationStatus}" VerticalAlignment="Center" Margin="2,0,8,0"/>
            <Button Content="{loc:Loc RmvToGltfExporter.SelectAll}" Command="{Binding SelectAllAnimationsCommand}" IsEnabled="{Binding ExportAnimations}" Margin="2,0" Padding="6,0"/>
            <Button Content="{loc:Loc RmvToGltfExporter.SelectNone}" Command="{Binding SelectNoneAnimationsCommand}" IsEnabled="{Binding ExportAnimations}" Margin="2,0" Padding="6,0"/>
            <TextBox Text="{Binding AnimationSearch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="180" Margin="8,0,0,0" ToolTip="{loc:Loc RmvToGltfExporter.FilterAnimations}"/>
        </DockPanel>

        <ListBox Grid.Row="7" Grid.ColumnSpan="4"
                 ItemsSource="{Binding FilteredAnimationOptions}"
                 IsEnabled="{Binding ExportAnimations}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ContainerName}"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
