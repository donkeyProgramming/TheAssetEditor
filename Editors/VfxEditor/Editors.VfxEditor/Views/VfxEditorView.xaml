<UserControl x:Class="Editors.VfxEditor.Views.VfxEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Editors.VfxEditor.ViewModels"
             xmlns:doc="clr-namespace:Editors.VfxEditor.Document">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:CurveEditor}">
            <StackPanel Margin="12,4,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc VfxEditor.Channel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" DisplayMemberPath="Name" MinWidth="110"/>
                    <Button Content="{loc:Loc VfxEditor.CopyChannel}" Command="{Binding AddChannelCommand}" Margin="8,0,0,0" Padding="6,0"
                            ToolTip="{loc:Loc VfxEditor.CopiesThePickedChannelToThe}"/>
                    <Button Content="{loc:Loc VfxEditor.RemoveChannel}" Command="{Binding RemoveChannelCommand}" Margin="4,0,0,0" Padding="6,0"
                            ToolTip="{loc:Loc VfxEditor.RefusedWhileTheMappingReadsThe}"/>
                    <Button Content="{loc:Loc VfxEditor.AddKey}" Command="{Binding AddKeyCommand}" Margin="8,0,0,0" Padding="6,0"
                            ToolTip="{loc:Loc VfxEditor.CopiesThePickedKeyToA}"/>
                    <Button Content="{loc:Loc VfxEditor.DeleteKey}" Command="{Binding DeleteKeyCommand}" Margin="4,0,0,0" Padding="6,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,2" Opacity="0.7">
                    <TextBlock Text="{loc:Loc VfxEditor.Time}" Width="62"/>
                    <TextBlock Text="{loc:Loc VfxEditor.Value}" Width="62"/>
                    <TextBlock Text="{loc:Loc VfxEditor.In}" Width="92"/>
                    <TextBlock Text="{loc:Loc VfxEditor.Out}" Width="92"/>
                    <TextBlock Text="{loc:Loc VfxEditor.TanInX}" Width="62"/>
                    <TextBlock Text="{loc:Loc VfxEditor.TanInY}" Width="62"/>
                    <TextBlock Text="{loc:Loc VfxEditor.TanOutX}" Width="62"/>
                    <TextBlock Text="{loc:Loc VfxEditor.TanOutY}" Width="62"/>
                    <TextBlock Text="{loc:Loc VfxEditor.Flag}" Width="52"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <EventSetter Event="PreviewGotKeyboardFocus" Handler="KeyRow_PreviewGotKeyboardFocus"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CurveKeyRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="60" Margin="0,0,2,0" Text="{Binding Time}"/>
                                <TextBox Width="60" Margin="0,0,2,0" Text="{Binding Value}"/>
                                <ComboBox Width="90" Margin="0,0,2,0" ItemsSource="{x:Static doc:CurveText.Interpolations}" SelectedItem="{Binding In}"/>
                                <ComboBox Width="90" Margin="0,0,2,0" ItemsSource="{x:Static doc:CurveText.Interpolations}" SelectedItem="{Binding Out}"/>
                                <TextBox Width="60" Margin="0,0,2,0" Text="{Binding TanInX}"/>
                                <TextBox Width="60" Margin="0,0,2,0" Text="{Binding TanInY}"/>
                                <TextBox Width="60" Margin="0,0,2,0" Text="{Binding TanOutX}"/>
                                <TextBox Width="60" Margin="0,0,2,0" Text="{Binding TanOutY}"/>
                                <TextBox Width="50" Text="{Binding Flag}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc VfxEditor.Mapping}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Mapping}" MinWidth="220"
                             ToolTip="{loc:Loc VfxEditor.OutputRandomMinMaxForEach}"/>
                </StackPanel>
                <Border BorderBrush="#40808080" BorderThickness="1" Width="302" Height="82" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CurveLine}">
                                <Polyline Points="{Binding Points}" Stroke="{Binding Colour}" StrokeThickness="{Binding Thickness}" ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding Range, StringFormat='Over the particle or emitter life, 0 to 1; values {0}'}" Opacity="0.7" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="{loc:Loc VfxEditor.New}" Command="{Binding NewFileCommand}" ToolTip="{loc:Loc VfxEditor.ANewEffectWithNothingIn}"/>
            <Button Content="{loc:Loc VfxEditor.Open}" Command="{Binding OpenFileCommand}" ToolTip="{loc:Loc VfxEditor.PickAVfxXmlFromThe}"/>
            <Separator/>
            <Button Content="{loc:Loc VfxEditor.Save}" Command="{Binding SaveFileCommand}" ToolTip="{loc:Loc VfxEditor.CtrlSIntoTheEditablePack}"/>
            <Button Content="{loc:Loc VfxEditor.SaveAs}" Command="{Binding SaveFileAsCommand}"/>
            <Separator/>
            <Button Content="{loc:Loc VfxEditor.Undo}" Command="{Binding UndoCommand}" ToolTip="{loc:Loc VfxEditor.CtrlZ}"/>
            <Button Content="{loc:Loc VfxEditor.Redo}" Command="{Binding RedoCommand}" ToolTip="{loc:Loc VfxEditor.CtrlY}"/>
            <Separator/>
            <TextBlock Text="{loc:Loc VfxEditor.Quality}" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox ItemsSource="{Binding TierNames}" SelectedIndex="{Binding Tier}" Width="90"/>
            <CheckBox Content="{loc:Loc VfxEditor.ThisTierOnly}" IsChecked="{Binding ThisTierOnly}" Margin="8,0,0,0" VerticalAlignment="Center"
                      ToolTip="{loc:Loc VfxEditor.OffAnEditAlsoReachesEvery}"/>
        </ToolBar>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="6,3" TextTrimming="CharacterEllipsis"/>
        <Grid>
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Margin="12"
                       Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}"/>
            <Grid Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="150"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2*" MinWidth="250"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="3*" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <TreeView ItemsSource="{Binding Tree}" SelectedItemChanged="Tree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:VfxTreeNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Label}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top" Margin="4">
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding CanAddProperty, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding PropertyNameChoices}" SelectedItem="{Binding NewPropertyName}" Width="220"/>
                            <Button Content="{loc:Loc VfxEditor.AddProperty}" Command="{Binding AddPropertyCommand}" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="{loc:Loc VfxEditor.WrittenTheWayVanillaMostOften}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsChainNode, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding FragmentChoices}" SelectedItem="{Binding NewFragment}" Width="220"/>
                            <Button Content="{loc:Loc VfxEditor.AddModifier}" Command="{Binding AddModifierCommand}" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="{loc:Loc VfxEditor.WithThePropertiesVanillaMostOften}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsBlockMissing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc VfxEditor.NoModifiersAtThisTierSo}" Foreground="OrangeRed" VerticalAlignment="Center"/>
                            <Button Content="{loc:Loc VfxEditor.CopyUltraSBlockHere}" Command="{Binding CopyUltraBlockCommand}" Margin="6,0,0,0" Padding="6,0"/>
                        </StackPanel>
                        <Button Content="{loc:Loc VfxEditor.RemoveModifier}" Command="{Binding RemoveModifierCommand}" HorizontalAlignment="Left" Padding="6,0" Margin="0,2"
                                Visibility="{Binding IsModifierNode, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsEmitterNode, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding NewEmitterId, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                            <Button Content="{loc:Loc VfxEditor.DuplicateEmitter}" Command="{Binding DuplicateEmitterCommand}" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="{loc:Loc VfxEditor.CopiesTheEmitterItsBehaviourChain}"/>
                            <Button Content="{loc:Loc VfxEditor.Rename}" Command="{Binding RenameEmitterCommand}" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="{loc:Loc VfxEditor.GivesTheEmitterItsBehaviourChain}"/>
                            <Button Content="{loc:Loc VfxEditor.RemoveEmitter}" Command="{Binding RemoveEmitterCommand}" Margin="4,0,0,0" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsEmitterNode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc VfxEditor.Type}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding EmitterTypes}" SelectedItem="{Binding EmitterType}" Width="160"
                                      ToolTip="{loc:Loc VfxEditor.ContinuousMeshDrawsQuadsContinuousRigid}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsEmittersNode, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding NewEmitterId, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <ComboBox ItemsSource="{Binding EmitterTypes}" SelectedItem="{Binding NewEmitterType}" Width="140" Margin="4,0,0,0"/>
                            <Button Content="{loc:Loc VfxEditor.NewEmitter}" Command="{Binding NewEmitterCommand}" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="{loc:Loc VfxEditor.AnEmitterItsBehaviourChainAt}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsReferencesNode, Converter={StaticResource BoolToVis}}">
                            <ComboBox IsEditable="True" ItemsSource="{Binding EffectChoices}" Text="{Binding NewReferenceTarget, UpdateSourceTrigger=PropertyChanged}" Width="260">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                            <Button Content="{loc:Loc VfxEditor.AddReference}" Command="{Binding AddReferenceCommand}" Margin="4,0,0,0" Padding="6,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding IsReferenceNode, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding OverrideChoices}" SelectedItem="{Binding NewOverrideName}" Width="180"/>
                            <Button Content="{loc:Loc VfxEditor.AddOverride}" Command="{Binding AddOverrideCommand}" Margin="4,0,0,0" Padding="6,0"/>
                            <Button Content="{loc:Loc VfxEditor.AllOn}" Command="{Binding AllOverridesOnCommand}" Margin="8,0,0,0" Padding="6,0"/>
                            <Button Content="{loc:Loc VfxEditor.AllOff}" Command="{Binding AllOverridesOffCommand}" Margin="4,0,0,0" Padding="6,0"/>
                            <Button Content="{loc:Loc VfxEditor.RemoveReference}" Command="{Binding RemoveReferenceCommand}" Margin="8,0,0,0" Padding="6,0"/>
                        </StackPanel>
                        <Button Content="{loc:Loc VfxEditor.RemoveOverride}" Command="{Binding RemoveOverrideCommand}" HorizontalAlignment="Left" Padding="6,0" Margin="0,2"
                                Visibility="{Binding IsOverrideNode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PropertyRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*" MinWidth="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" VerticalAlignment="Center"
                                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value}" Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}">
                                            <TextBox.Style>
                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                            <Setter Property="BorderBrush" Value="Red"/>
                                                            <Setter Property="ToolTip" Value="{loc:Loc VfxEditor.NotANumberSoTheFile}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="{loc:Loc VfxEditor.Browse}" Padding="6,0" Margin="4,0,0,0" ToolTip="{loc:Loc VfxEditor.PickTheFileFromTheLoaded}"
                                                    Visibility="{Binding IsPath, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{loc:Loc VfxEditor.Open}" Padding="6,0" Margin="4,0,0,0" ToolTip="{loc:Loc VfxEditor.OpenTheFileInTheApp}"
                                                    Visibility="{Binding IsPath, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Note}" Margin="6,0" VerticalAlignment="Center" Opacity="0.7"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="{loc:Loc VfxEditor.Remove}" Padding="6,0" ToolTip="{loc:Loc VfxEditor.RemoveThisProperty}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RemovePropertyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <ContentControl Grid.Row="1" Grid.ColumnSpan="4" Content="{Binding Curve}"/>
                                        <Image Grid.Row="1" Grid.Column="1" Source="{Binding Thumbnail}" MaxHeight="64" MaxWidth="128" HorizontalAlignment="Left" Margin="0,2" Stretch="Uniform"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding Scene, Mode=OneTime}"/>
                    <DockPanel Grid.Row="1" Margin="4">
                        <ToggleButton DockPanel.Dock="Left" Content="{loc:Loc VfxEditor.Play}" IsChecked="{Binding IsPlaying}" Width="50"/>
                        <CheckBox DockPanel.Dock="Left" Content="{loc:Loc VfxEditor.LoopAt}" IsChecked="{Binding Loop}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                        <TextBox DockPanel.Dock="Left" Text="{Binding LoopLength}" Width="40"/>
                        <TextBlock DockPanel.Dock="Left" Text="s" Margin="2,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Loc VfxEditor.Speed}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBox DockPanel.Dock="Left" Text="{Binding Speed}" Width="40"/>
                        <CheckBox DockPanel.Dock="Left" Content="{loc:Loc VfxEditor.Grid}" IsChecked="{Binding ShowGrid}" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ToolTip="{loc:Loc VfxEditor.TheGroundGridAndItsAxis}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewTime, StringFormat='{}{0:0.00} s'}" Width="55" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Slider Minimum="0" Maximum="{Binding LoopLength}" Value="{Binding PreviewTime}" Margin="8,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Grid.Row="2" Margin="4,0,4,4">
                        <CheckBox Content="{loc:Loc VfxEditor.Projectile}" IsChecked="{Binding Projectile}" VerticalAlignment="Center"
                                  ToolTip="{loc:Loc VfxEditor.FlyTheEffectInAStraight}"/>
                        <TextBlock Text="{loc:Loc VfxEditor.Velocity}" Margin="10,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ProjectileSpeed}" Width="50"
                                 ToolTip="{loc:Loc VfxEditor.MetresASecondAsProjectilesTables}"/>
                        <TextBlock Text="m/s" Margin="2,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc VfxEditor.Axis}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AxisNames}" SelectedIndex="{Binding ProjectileAxis}" Width="55"
                                  ToolTip="{loc:Loc VfxEditor.TheEffectSLocalAxisThe}"/>
                        <CheckBox Content="{loc:Loc VfxEditor.Static}" IsChecked="{Binding StaticView}" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ToolTip="{loc:Loc VfxEditor.WatchFromTheProjectileItAnd}"/>
                        <Button Content="{loc:Loc VfxEditor.Model}" Command="{Binding LoadModelCommand}" Margin="10,0,0,0" Padding="6,0"
                                ToolTip="{loc:Loc VfxEditor.ARigidModelV2FromThe}"/>
                        <TextBlock Text="{Binding ModelName}" Margin="6,0" VerticalAlignment="Center"/>
                        <Button Content="{loc:Loc VfxEditor.Clear}" Command="{Binding ClearModelCommand}" Padding="6,0"/>
                        <Button Content="{loc:Loc VfxEditor.Lighting}" Command="{Binding OpenRenderSettingsCommand}" Margin="10,0,0,0" Padding="6,0"
                                ToolTip="{loc:Loc VfxEditor.TheKitbashEditorSRenderSettings}"/>
                        <Button Content="{loc:Loc VfxEditor.Screenshot}" Command="{Binding TakeScreenshotCommand}" Margin="4,0,0,0" Padding="6,0"
                                ToolTip="{loc:Loc VfxEditor.SavesTheNextFrameAtTwice}"/>
                    </WrapPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding PreviewLines}" MaxHeight="110" ToolTip="{loc:Loc VfxEditor.WhatThePreviewCouldNotFind}"
                             Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
