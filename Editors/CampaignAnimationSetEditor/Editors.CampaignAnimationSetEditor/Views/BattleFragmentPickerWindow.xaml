<Window x:Class="Editors.CampaignAnimationSetEditor.Views.BattleFragmentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Editors.CampaignAnimationSetEditor.Views"
        Style="{StaticResource CustomWindowStyle}"
        Title="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.GenerateFromBattleAnimationSet}" Height="500" Width="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:AnimationFragmentDisplayConverter x:Key="FragmentDisplayConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Margin="0,0,0,5" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.FilterByPath}"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Fragments}" SelectedItem="{Binding SelectedFragment}"
                 x:Name="FragmentListBox" MouseDoubleClick="FragmentListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource FragmentDisplayConverter}}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <CheckBox Grid.Row="2" Margin="0,10,0,0" Content="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.ForceGroundAnimationsIgnoreFlying}"
                  IsChecked="{Binding ForceGroundAnimations}"
                  ToolTip="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.IfThisSetHasFlyingAnimations}"/>

        <CheckBox Grid.Row="3" Margin="0,10,0,0" Content="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.FreezeRootBoneForRiderAnimations}"
                  IsChecked="{Binding FreezeRootForRiderAnimations}"
                  ToolTip="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.OnlyAppliesIfTheSelectedSet}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.Generate}" Width="90" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{loc:Loc CampaignAnimationSetEditor.BattleFragmentPicker.Cancel}" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
