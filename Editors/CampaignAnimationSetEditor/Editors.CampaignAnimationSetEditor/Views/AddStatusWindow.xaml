<Window x:Class="Editors.CampaignAnimationSetEditor.Views.AddStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource CustomWindowStyle}"
        Title="Add status" Height="160" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Status name:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="1" x:Name="StatusCombo" ItemsSource="{Binding KnownStatuses}"
                  Text="{Binding StatusName, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True" IsTextSearchEnabled="True"
                  ToolTip="Pick a known vanilla status, or type a custom/modded name."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Add" Width="90" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
