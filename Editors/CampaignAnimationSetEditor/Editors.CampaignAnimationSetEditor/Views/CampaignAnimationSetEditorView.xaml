<UserControl x:Class="Editors.CampaignAnimationSetEditor.Views.CampaignAnimationSetEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Shared.Ui.Common.ValueConverters;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:local="clr-namespace:Editors.CampaignAnimationSetEditor.Views"
             xmlns:services="clr-namespace:Editors.CampaignAnimationSetEditor.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:StatusDescriptionConverter x:Key="StatusDescriptionConverter"/>
        <local:PathTailConverter x:Key="PathTailConverter"/>
        <local:PoseIdDisplayConverter x:Key="PoseIdDisplayConverter"/>


        <!-- Bold, larger headers so each category reads clearly when all sections are stacked. -->
        <Style x:Key="SectionGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No TextTrimming: PathTailConverter already shortened the string from the left. Adding
             CharacterEllipsis on top would also trim the right, hiding the filename. -->
        <Style x:Key="PathCellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="{loc:Loc CampaignAnimationSetEditor.Open}" Command="{Binding OpenCommand}" Padding="10,5" Height="44" VerticalContentAlignment="Center"
                    ToolTip="{loc:Loc CampaignAnimationSetEditor.OpenADifferentCampaignAnimationSet}"/>
            <Button Content="{loc:Loc CampaignAnimationSetEditor.Save}" Command="{Binding SaveClickedCommand}" Padding="10,5" Height="44" VerticalContentAlignment="Center"/>
            <Button Content="{loc:Loc CampaignAnimationSetEditor.SaveAs}" Command="{Binding SaveAsClickedCommand}" Padding="10,5" Height="44" VerticalContentAlignment="Center"/>
            <Separator/>
            <Button Command="{Binding GenerateFromBattleSetCommand}" Padding="10,5" Height="44">
                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.GenerateFromBattleAnimationSet}" TextWrapping="Wrap" TextAlignment="Center" Width="120"/>
            </Button>
            <Button Command="{Binding FreezeAnimRootInAnimationCommand}" Padding="10,5" Height="44"
                    ToolTip="{loc:Loc CampaignAnimationSetEditor.FreezeAnimRoot.Tooltip}">
                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.FreezeAnimRoot}" TextWrapping="Wrap" TextAlignment="Center" Width="100"/>
            </Button>
            <Separator/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5,0">
                <StackPanel Orientation="Horizontal"
                            ToolTip="{loc:Loc CampaignAnimationSetEditor.TheNameStoredInsideTheBin}">
                    <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Reference}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Bin.Reference}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            ToolTip="{loc:Loc CampaignAnimationSetEditor.FixedToTheSkeletonEveryAnimation}">
                    <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Skeleton}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Bin.SkeletonName}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </ToolBar>

        <!-- Load error banner -->
        <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFECB5" BorderThickness="0,0,0,1" Padding="10"
                Visibility="{Binding LoadError, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="#664D03"/>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" Visibility="{Binding Bin, Converter={StaticResource NullVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddStatusCommand}" Width="60" Margin="0,0,5,0"/>
                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemoveStatusCommand}" CommandParameter="{Binding SelectedStatus}" Width="60"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc CampaignAnimationSetEditor.Statuses}" FontWeight="Bold" FontSize="14" Margin="5,5,5,0"/>
                <TextBlock DockPanel.Dock="Top" Margin="5,2,5,5" TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic"
                           Text="{loc:Loc CampaignAnimationSetEditor.HoverAStatusForWhatIt}"/>
                <ListBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       ToolTip="{Binding Name, Converter={StaticResource StatusDescriptionConverter}}"
                                       ToolTipService.ShowDuration="60000"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FF606060"/>

            <!-- Selected status content -->
            <Grid Grid.Column="2" DataContext="{Binding SelectedStatus}">
                <!-- Global status: persistent metadata / poses / docks -->
                <ScrollViewer Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.PersistentMetadata}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddPersistentMetaDataCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemovePersistentMetaDataCommand}" CommandParameter="{Binding SelectedItem, ElementName=PersistentMetaGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="PersistentMetaGrid" ItemsSource="{Binding PersistentMetaData}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Type}" ToolTip="{loc:Loc CampaignAnimationSetEditor.TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.AnimationMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.SoundMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.BlendTime}" Binding="{Binding BlendTime}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.Poses}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddPoseCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemovePoseCommand}" CommandParameter="{Binding SelectedItem, ElementName=PosesGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="PosesGrid" ItemsSource="{Binding Poses}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Type}" ToolTip="{loc:Loc CampaignAnimationSetEditor.TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.AnimationMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.SoundMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.BlendTime}" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.PoseId}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PoseId, Converter={StaticResource PoseIdDisplayConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{x:Static services:KnownPoseIdOptions.All}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Value"
                                                              SelectedValue="{Binding PoseId, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="{loc:Loc CampaignAnimationSetEditor.CorrespondsToASpecificHandFace}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.Docks}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddDockCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemoveDockCommand}" CommandParameter="{Binding SelectedItem, ElementName=DocksGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="DocksGrid" ItemsSource="{Binding Docks}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.Dock}" Binding="{Binding Dock}" Width="1.5*"/>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Type}" ToolTip="{loc:Loc CampaignAnimationSetEditor.TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.AnimationMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.SoundMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.BlendTime}" Binding="{Binding BlendTime}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Normal status: every category shown stacked on one page (no tabs) so nothing
                     is hidden by default. -->
                <ScrollViewer Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.Idle}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddIdleCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemoveIdleCommand}" CommandParameter="{Binding SelectedItem, ElementName=IdleGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="IdleGrid" ItemsSource="{Binding Idle}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Type}" ToolTip="{loc:Loc CampaignAnimationSetEditor.TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Meta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MetaFile, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MetaFile, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.SoundMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.BlendTime}" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.Weight}" Binding="{Binding Weight}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.Selection}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddSelectionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemoveSelectionCommand}" CommandParameter="{Binding SelectedItem, ElementName=SelectionGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="SelectionGrid" ItemsSource="{Binding Selection}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Type}" ToolTip="{loc:Loc CampaignAnimationSetEditor.TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Meta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MetaFile, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MetaFile, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.SoundMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.BlendTime}" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.Weight}" Binding="{Binding Weight}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.Locomotion}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddLocomotionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemoveLocomotionCommand}" CommandParameter="{Binding SelectedItem, ElementName=LocomotionGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="LocomotionGrid" ItemsSource="{Binding Locomotion}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="2*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{loc:Loc CampaignAnimationSetEditor.Type}" ToolTip="{loc:Loc CampaignAnimationSetEditor.TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.AnimationMeta}" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.SoundMeta}" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.BlendTime}" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.ModelScale}" Binding="{Binding ModelScale}" Width="80"/>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.Distance}" Binding="{Binding DistanceTraveled}" Width="70"/>
                                        <DataGridTextColumn Header="{loc:Loc CampaignAnimationSetEditor.MinDistance}" Binding="{Binding DistanceMinTravled}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc CampaignAnimationSetEditor.Transitions}" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Add}" Command="{Binding AddTransitionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="{loc:Loc CampaignAnimationSetEditor.Remove}" Command="{Binding RemoveTransitionCommand}" CommandParameter="{Binding SelectedItem, ElementName=TransitionsGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="TransitionsGrid" ItemsSource="{Binding Transitions}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc CampaignAnimationSetEditor.Animation}" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
