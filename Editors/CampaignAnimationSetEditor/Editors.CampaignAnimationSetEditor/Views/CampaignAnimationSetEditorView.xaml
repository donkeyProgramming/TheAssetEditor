<UserControl x:Class="Editors.CampaignAnimationSetEditor.Views.CampaignAnimationSetEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:conv="clr-namespace:Shared.Ui.Common.ValueConverters;assembly=Shared.Ui"
             xmlns:local="clr-namespace:Editors.CampaignAnimationSetEditor.Views"
             xmlns:services="clr-namespace:Editors.CampaignAnimationSetEditor.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:NullVisibilityConverter x:Key="NullVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:StatusDescriptionConverter x:Key="StatusDescriptionConverter"/>
        <local:PathTailConverter x:Key="PathTailConverter"/>
        <local:PoseIdDisplayConverter x:Key="PoseIdDisplayConverter"/>

        <sys:String x:Key="TypeColumnTooltip">Which status this animation was originally authored for. Rows often show a different value than the status they live under - a row inside status_battle commonly shows Type=status_normal, meaning it reuses status_normal's authored animation. Vanilla files only ever use "global" or "status_normal" here.</sys:String>

        <!-- Bold, larger headers so each category reads clearly when all sections are stacked. -->
        <Style x:Key="SectionGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No TextTrimming: PathTailConverter already shortened the string from the left. Adding
             CharacterEllipsis on top would also trim the right, hiding the filename. -->
        <Style x:Key="PathCellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="Open" Command="{Binding OpenCommand}" Padding="10,5" Height="44" VerticalContentAlignment="Center"
                    ToolTip="Open a different campaign animation set .bin file in this editor."/>
            <Button Content="Save" Command="{Binding SaveClickedCommand}" Padding="10,5" Height="44" VerticalContentAlignment="Center"/>
            <Button Content="Save As" Command="{Binding SaveAsClickedCommand}" Padding="10,5" Height="44" VerticalContentAlignment="Center"/>
            <Separator/>
            <Button Command="{Binding GenerateFromBattleSetCommand}" Padding="10,5" Height="44">
                <TextBlock Text="Generate from Battle Animation Set" TextWrapping="Wrap" TextAlignment="Center" Width="120"/>
            </Button>
            <Separator/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5,0">
                <StackPanel Orientation="Horizontal"
                            ToolTip="The name stored inside the .bin itself. Kept in sync with the file's own name automatically on Save - not meant to be edited directly.">
                    <TextBlock Text="Reference: " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Bin.Reference}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            ToolTip="Fixed to the skeleton every animation in this set is authored against - set automatically from the battle set used to generate it (or inherited as-is from an existing file). Never meant to be edited by hand.">
                    <TextBlock Text="Skeleton: " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Bin.SkeletonName}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </ToolBar>

        <!-- Load error banner -->
        <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFECB5" BorderThickness="0,0,0,1" Padding="10"
                Visibility="{Binding LoadError, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="#664D03"/>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" Visibility="{Binding Bin, Converter={StaticResource NullVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                    <Button Content="Add" Command="{Binding AddStatusCommand}" Width="60" Margin="0,0,5,0"/>
                    <Button Content="Remove" Command="{Binding RemoveStatusCommand}" CommandParameter="{Binding SelectedStatus}" Width="60"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Statuses" FontWeight="Bold" FontSize="14" Margin="5,5,5,0"/>
                <TextBlock DockPanel.Dock="Top" Margin="5,2,5,5" TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic"
                           Text="Hover a status for what it means."/>
                <ListBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       ToolTip="{Binding Name, Converter={StaticResource StatusDescriptionConverter}}"
                                       ToolTipService.ShowDuration="60000"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FF606060"/>

            <!-- Selected status content -->
            <Grid Grid.Column="2" DataContext="{Binding SelectedStatus}">
                <!-- Global status: persistent metadata / poses / docks -->
                <ScrollViewer Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Persistent metadata" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddPersistentMetaDataCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemovePersistentMetaDataCommand}" CommandParameter="{Binding SelectedItem, ElementName=PersistentMetaGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="PersistentMetaGrid" ItemsSource="{Binding PersistentMetaData}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Poses" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddPoseCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemovePoseCommand}" CommandParameter="{Binding SelectedItem, ElementName=PosesGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="PosesGrid" ItemsSource="{Binding Poses}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTemplateColumn Header="Pose id" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PoseId, Converter={StaticResource PoseIdDisplayConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{x:Static services:KnownPoseIdOptions.All}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Value"
                                                              SelectedValue="{Binding PoseId, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="Corresponds to a specific hand/face pose slot on the battle skeleton - see KnownPoseId for how this was confirmed. Unlike Status/Action type, this is a closed set: pick one rather than typing a custom value."/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Docks" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddDockCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveDockCommand}" CommandParameter="{Binding SelectedItem, ElementName=DocksGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="DocksGrid" ItemsSource="{Binding Docks}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Dock" Binding="{Binding Dock}" Width="1.5*"/>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Normal status: every category shown stacked on one page (no tabs) so nothing
                     is hidden by default. -->
                <ScrollViewer Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Idle" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddIdleCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveIdleCommand}" CommandParameter="{Binding SelectedItem, ElementName=IdleGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="IdleGrid" ItemsSource="{Binding Idle}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MetaFile, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MetaFile, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Selection" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddSelectionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveSelectionCommand}" CommandParameter="{Binding SelectedItem, ElementName=SelectionGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="SelectionGrid" ItemsSource="{Binding Selection}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MetaFile, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MetaFile, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Locomotion" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddLocomotionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveLocomotionCommand}" CommandParameter="{Binding SelectedItem, ElementName=LocomotionGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="LocomotionGrid" ItemsSource="{Binding Locomotion}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="2*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="Model scale" Binding="{Binding ModelScale}" Width="80"/>
                                        <DataGridTextColumn Header="Distance" Binding="{Binding DistanceTraveled}" Width="70"/>
                                        <DataGridTextColumn Header="Min distance" Binding="{Binding DistanceMinTravled}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Transitions" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddTransitionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveTransitionCommand}" CommandParameter="{Binding SelectedItem, ElementName=TransitionsGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="TransitionsGrid" ItemsSource="{Binding Transitions}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="2*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="Transition to" Binding="{Binding TransitionTo}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Action" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddActionCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveActionCommand}" CommandParameter="{Binding SelectedItem, ElementName=ActionGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="ActionGrid" ItemsSource="{Binding Action}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Meta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Meta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTemplateColumn Header="Action type" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ActionType}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{x:Static services:KnownActionTypeNames.All}"
                                                              Text="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True" IsTextSearchEnabled="True"
                                                              ToolTip="Pick a known vanilla action type, or type a custom/modded name."/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- Action id hidden: surveyed as NOT a per-type code (the same id is reused
                                             by different ActionTypes across vanilla files, and each type spans
                                             hundreds of different ids) - it behaves like a plain row counter, so the
                                             editor auto-assigns it on Add instead of asking the user to pick one. The
                                             underlying ActionEntry.ActionId property is untouched for round-trip
                                             fidelity on existing files. -->
                                        <!-- Unknown hidden: surveyed as always false across every Action entry in the
                                             entire vanilla corpus (~1700 rows), so showing it is pure noise. The
                                             underlying ActionEntry.Unknown property is untouched for round-trip fidelity. -->
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Porthole" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddPortholeCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemovePortholeCommand}" CommandParameter="{Binding SelectedItem, ElementName=PortholeGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="PortholeGrid" ItemsSource="{Binding Porthole}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Unknown" Style="{StaticResource SectionGroupBoxStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="Add" Command="{Binding AddUnknownCommand}" Width="60" Margin="0,0,5,0"/>
                                    <Button Content="Remove" Command="{Binding RemoveUnknownCommand}" CommandParameter="{Binding SelectedItem, ElementName=UnknownGrid}" Width="60"/>
                                </StackPanel>
                                <DataGrid x:Name="UnknownGrid" ItemsSource="{Binding Unknown}" AutoGenerateColumns="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Animation" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Animation, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Type}" Width="2*">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Type" ToolTip="{StaticResource TypeColumnTooltip}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Animation meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AnimationMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding AnimationMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Sound meta" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoundMeta, Converter={StaticResource PathTailConverter}}" Style="{StaticResource PathCellTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SoundMeta, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Blend time" Binding="{Binding BlendTime}" Width="70"/>
                                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="70"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
