<Window x:Class="Editors.MusicProjectEditor.Views.AddCultureWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Title="Add Culture" Height="760" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding MissingFileWarning}" TextWrapping="Wrap"
                   Foreground="#E0A800" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MissingFileWarning}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- The identity of the new culture, asked once. The two keys differ because the two
             scripts are keyed differently, which a modder should not have to keep track of.
             There is no separate "musical culture name" field - it is always the Audio State
             verbatim, which is what the shipped scripts do. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio State" VerticalAlignment="Center" Margin="0,0,10,2"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                     Text="{Binding AudioState, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AudioStateHelp}" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.75" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Subculture key" VerticalAlignment="Center" Margin="0,0,10,2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                     IsEnabled="{Binding HasCampaign}"
                     Text="{Binding SubcultureKey, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubcultureKeyHelp}" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.75" Margin="0,0,0,8"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding WwiseNote}" TextWrapping="Wrap"
                   FontSize="11" Opacity="0.65" FontStyle="Italic" Margin="0,0,0,8"/>

        <!-- One row per thing that needs wiring: what it affects and what it posts are
             front and centre; how many places it patches and the raw pseudocode are the
             advanced detail, tucked away collapsed. -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="3"
                                Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Include}" FontWeight="Bold"
                                          Content="{Binding Title}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           FontSize="11" Opacity="0.8" Margin="20,4,0,2"/>
                                <TextBlock Text="{Binding EventInfo}" TextWrapping="Wrap"
                                           FontSize="11" Opacity="0.9" FontFamily="Consolas" Margin="20,2,0,2"/>
                                <TextBlock Text="{Binding AudioSupportNote}" TextWrapping="Wrap"
                                           FontSize="11" Opacity="0.8" Margin="20,0,0,6"/>

                                <StackPanel Margin="20,0,0,0" Orientation="Horizontal" IsEnabled="{Binding Include}">
                                    <CheckBox IsChecked="{Binding UseExistingAudio}"
                                              Content="Borrow an existing culture's audio instead of authoring new"
                                              ToolTip="Copies that culture's entry wholesale, so nothing new is needed in Wwise. This is what vanilla does to share one battle theme between Bretonnia, Dwarfs and Empire."/>
                                    <ComboBox Margin="10,0,0,0" MinWidth="220" VerticalAlignment="Center"
                                              Visibility="{Binding UseExistingAudio, Converter={StaticResource BoolToCollapsedConverter}}"
                                              ItemsSource="{Binding ReferenceCandidates}"
                                              SelectedItem="{Binding ReferenceCulture, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="An existing culture already wired into this slot."/>
                                </StackPanel>

                                <Expander Header="Advanced" Margin="20,8,0,0" IsExpanded="False">
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Scope}" TextWrapping="Wrap"
                                                   FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="11"
                                                 MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                                 Background="Transparent" BorderThickness="0" Opacity="0.9"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding AudioProjectHelp}" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.7"/>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#D9534F" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add" Width="90" Padding="0,4" Margin="0,0,8,0" IsDefault="True"
                    IsEnabled="{Binding CanApply}" Click="OnAddClick"/>
            <Button Content="Cancel" Width="90" Padding="0,4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
