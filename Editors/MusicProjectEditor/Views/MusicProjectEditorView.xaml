<UserControl x:Class="Editors.MusicProjectEditor.Views.MusicProjectEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Editors.MusicProjectEditor.ViewModels"
             xmlns:waveform="clr-namespace:Editors.Audio.WaveformVisualiser.Presentation;assembly=Editors.Audio"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="6">
            <Button DockPanel.Dock="Left" Content="{loc:Loc MusicProjectEditor.New}" Command="{Binding NewCommand}" Padding="12,3" Margin="0,0,6,0"
                    ToolTip="{loc:Loc MusicProjectEditor.StartANewEmptyMusicProject}"/>
            <Button DockPanel.Dock="Left" Content="{loc:Loc MusicProjectEditor.Open}" Command="{Binding OpenCommand}" Padding="12,3" Margin="0,0,6,0"
                    ToolTip="{loc:Loc MusicProjectEditor.OpenAMusicProjectFromThe}"/>
            <Button DockPanel.Dock="Left" Content="{loc:Loc MusicProjectEditor.Save}" Command="{Binding SaveProjectCommand}" Padding="12,3" Margin="0,0,6,0"
                    IsEnabled="{Binding IsProjectLoaded}"/>
            <Button DockPanel.Dock="Left" Content="{loc:Loc MusicProjectEditor.Build}" Command="{Binding BuildCommand}" Padding="12,3" Margin="0,0,10,0"
                    IsEnabled="{Binding IsProjectLoaded}" FontWeight="Bold"
                    ToolTip="{loc:Loc MusicProjectEditor.SaveThenRebuildBattleMusicDat}"/>
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc MusicProjectEditor.UnsavedChanges}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToCollapsedConverter}}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="12" Opacity="0.75">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProjectLoaded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="1" Visibility="{Binding IsProjectLoaded, Converter={StaticResource BoolToCollapsedConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: the cultures in the project -->
            <DockPanel Grid.Column="0" Margin="6,0,6,6">
                <TextBlock DockPanel.Dock="Top" Text="{Binding FilePathText}" FontSize="11" Opacity="0.6" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc MusicProjectEditor.Cultures}" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{loc:Loc MusicProjectEditor.Add}" Command="{Binding AddCultureCommand}" Padding="12,3" Margin="0,0,6,0"
                            ToolTip="{loc:Loc MusicProjectEditor.WireANewCultureIntoBoth}"/>
                    <Button Content="{loc:Loc MusicProjectEditor.Edit}" Command="{Binding EditCultureCommand}" Padding="12,3" Margin="0,0,6,0"
                            IsEnabled="{Binding HasSelectedCulture}"
                            ToolTip="{loc:Loc MusicProjectEditor.RunTheWizardAgainForThis}"/>
                    <Button Content="{loc:Loc MusicProjectEditor.Remove}" Command="{Binding RemoveCultureCommand}" Padding="12,3"
                            IsEnabled="{Binding HasSelectedCulture}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Cultures}" SelectedItem="{Binding SelectedCulture}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.AudioState}" Binding="{Binding AudioState}" Width="*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                        <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.Subculture}" Binding="{Binding SubcultureKey}" Width="*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                        <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.Events}" Binding="{Binding Summary}" Width="Auto" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Right: the selected culture's slots, and the audio of the selected one -->
            <Grid Grid.Column="1" Margin="0,0,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc MusicProjectEditor.Events}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding SelectedCulture.Events}" SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="None" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.Slot}" Binding="{Binding Title}" Width="2*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                            <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.Event}" Binding="{Binding EventText}" Width="2*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                            <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.StateGroup}" Binding="{Binding StateGroupName}" Width="2*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                            <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.State}" Binding="{Binding StateName}" Width="*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                            <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.Audio}" Binding="{Binding AudioSummary}" Width="80" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- The selected slot: what this culture plays there, and what vanilla cultures play there. -->
                <TabControl Grid.Row="1" Margin="0,8,0,0" Height="340"
                            Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibilityConverter}}">
                    <TabItem Header="{loc:Loc MusicProjectEditor.ThisCultureSAudio}">
                        <DockPanel Margin="4">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedEvent.Title}" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedEvent.Note}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,0,0,6"/>

                            <!-- The decision tree, for the slots whose music is one. Each branch narrows down
                                 when its wavs play; one with none plays its parent's. -->
                            <TreeView DockPanel.Dock="Left" Width="300" Margin="0,0,8,0" ItemsSource="{Binding TreeRoots}"
                                      SelectedItemChanged="OnTreeSelectedItemChanged"
                                      Visibility="{Binding HasSelectedTree, Converter={StaticResource BoolToCollapsedConverter}}">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:MusicTreeNodeViewModel}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}"/>
                                            <TextBlock Text="{Binding Summary, StringFormat=' ({0})'}" Opacity="0.65"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.Resources>
                            </TreeView>

                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                        Visibility="{Binding HasSelectedTree, Converter={StaticResource BoolToCollapsedConverter}}">
                                <TextBlock Text="{Binding SelectedTreeNode.Label}" FontWeight="Bold" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{loc:Loc MusicProjectEditor.SplitBy}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox MinWidth="140" ItemsSource="{Binding SplitLevels}" SelectedItem="{Binding SelectedSplitLevel}" DisplayMemberPath="DisplayName"/>
                                    <ComboBox MinWidth="180" Margin="6,0,0,0" ItemsSource="{Binding SplitValues}" SelectedItem="{Binding SelectedSplitValue}" DisplayMemberPath="DisplayName"/>
                                    <Button Content="{loc:Loc MusicProjectEditor.AddBranch}" Command="{Binding AddBranchCommand}" IsEnabled="{Binding CanAddBranch}" Padding="10,2" Margin="6,0,0,0"/>
                                    <Button Content="{loc:Loc MusicProjectEditor.RemoveBranch}" Command="{Binding RemoveBranchCommand}" IsEnabled="{Binding CanRemoveBranch}" Padding="10,2" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SplitHelp}" TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" IsEnabled="{Binding CanEditSelectedEventAudio}">
                                <Button Content="{loc:Loc MusicProjectEditor.AddWav}" Command="{Binding AddAudioCommand}" Padding="12,3" Margin="0,0,0,6"
                                        ToolTip="{loc:Loc MusicProjectEditor.PickAWavFromTheLoaded}"/>
                                <Button Content="{loc:Loc MusicProjectEditor.Remove}" Command="{Binding RemoveAudioCommand}" Padding="12,3"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding SelectedAudioFiles}" SelectedItem="{Binding SelectedAudioFile}"
                                     IsEnabled="{Binding CanEditSelectedEventAudio}"
                                     ToolTip="{loc:Loc MusicProjectEditor.SelectAWavToLoadIt}"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{loc:Loc MusicProjectEditor.VanillaReference}">
                        <DockPanel Margin="4">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc MusicProjectEditor.VanillaCulture}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox DockPanel.Dock="Left" MinWidth="200" ItemsSource="{Binding VanillaStates}" SelectedItem="{Binding SelectedVanillaState}"
                                          ToolTip="{loc:Loc MusicProjectEditor.EveryVanillaCultureWithMusicOf}"/>
                                <TextBlock/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding VanillaSummary}" TextWrapping="Wrap" FontSize="11" Opacity="0.85" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding VanillaClips}" SelectedItem="{Binding SelectedVanillaClip}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="None" HeadersVisibility="Column"
                                      ToolTip="{loc:Loc MusicProjectEditor.SelectAFileToLoadIt}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.WhereItPlays}" Binding="{Binding Where}" Width="3*" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                                    <DataGridTextColumn Header="{loc:Loc MusicProjectEditor.Length}" Binding="{Binding Length}" Width="70" ElementStyle="{DynamicResource {x:Type TextBlock}}"/>
                                    <DataGridTemplateColumn Header="{loc:Loc MusicProjectEditor.AlsoPlayedFor}" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Shared}" ToolTip="{Binding SharedToolTip}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <waveform:WaveformVisualiserView Grid.Row="2" Margin="0,6,0,0" DataContext="{Binding WaveformVisualiserViewModel}"
                                                 Visibility="{Binding DataContext.SelectedEvent, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
