<UserControl x:Class="AnimationEditor.MountAnimationCreator.RiderAttachmentSubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="450">

    <Expander>
        <Expander.Header>
            <TextBlock Style="{DynamicResource SectionHeader}" Text="{loc:Loc MountAnimationCreator.RiderAttachment}"/>
        </Expander.Header>
        <Grid Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="74"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="{loc:Loc MountAnimationCreator.RiderAttachment.RiderRootBone}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="BoneName"
                      ToolTip="{loc:Loc MountAnimationCreator.RiderAttachment.RiderRootBone.ToolTip}"
                      Text="{Binding SelectedRiderBone.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding SelectedRiderBone.Values}"
                      SelectedItem="{Binding SelectedRiderBone.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc MountAnimationCreator.RiderAttachment.MountVertex}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,1" VerticalContentAlignment="Center" IsReadOnly="True" Text="{Binding SelectedVertexesText.Value, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" ToolTip="{loc:Loc MountAnimationCreator.RiderAttachment.MountVertex.ToolTip}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="{loc:Loc MountAnimationCreator.Buttons.Set}" ToolTip="{loc:Loc MountAnimationCreator.Buttons.Set.ToolTip}" Click="{s:MethodBinding SetMountVertex}"/>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Style="{DynamicResource Info}" Text="{loc:Loc MountAnimationCreator.RiderAttachment.VertexHowTo}"/>
        </Grid>
    </Expander>
</UserControl>
