<UserControl x:Class="AnimationEditor.MountAnimationCreator.MountLinkSubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="450">

    <UserControl.Resources>
        <Style x:Key="SlotItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsValid.Value}" Value="false">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Expander>
        <Expander.Header>
            <TextBlock Style="{DynamicResource SectionHeader}" Text="{loc:Loc MountAnimationCreator.MountLinkShortcut}"/>
        </Expander.Header>
        <Grid Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="74"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource Info}" Text="{loc:Loc MountAnimationCreator.MountLink.Info}"/>

            <Label Grid.Row="1" Grid.Column="0" Content="{loc:Loc MountAnimationCreator.MountLink.Mount}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,1"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="FileName"
                      ToolTip="{loc:Loc MountAnimationCreator.MountLink.Mount.ToolTip}"
                      Text="{Binding MountLinkController.AnimationSetForMount.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding MountLinkController.AnimationSetForMount.Values}"
                      SelectedItem="{Binding MountLinkController.AnimationSetForMount.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="{loc:Loc MountAnimationCreator.Buttons.OpenSet}" ToolTip="{loc:Loc MountAnimationCreator.Buttons.OpenSet.ToolTip}" Click="{s:MethodBinding ViewMountFragmentAction}"/>

            <Label Grid.Row="2" Grid.Column="0" Content="{loc:Loc MountAnimationCreator.MountLink.Rider}"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,1"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="FileName"
                      ToolTip="{loc:Loc MountAnimationCreator.MountLink.Rider.ToolTip}"
                      Text="{Binding MountLinkController.AnimationSetForRider.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding MountLinkController.AnimationSetForRider.Values}"
                      SelectedItem="{Binding MountLinkController.AnimationSetForRider.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="{loc:Loc MountAnimationCreator.Buttons.OpenSet}" ToolTip="{loc:Loc MountAnimationCreator.Buttons.OpenSet.ToolTip}" Click="{s:MethodBinding ViewRiderFragmentAction}"/>

            <Label Grid.Row="3" Grid.Column="0" Content="{loc:Loc MountAnimationCreator.MountLink.MountTag}"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,1"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="DisplayName"
                      ItemContainerStyle="{StaticResource SlotItem}"
                      ToolTip="{loc:Loc MountAnimationCreator.MountLink.MountTag.ToolTip}"
                      Text="{Binding MountLinkController.SelectedMountTag.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding MountLinkController.SelectedMountTag.Values}"
                      SelectedItem="{Binding MountLinkController.SelectedMountTag.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <Label Grid.Row="4" Grid.Column="0" Content="{loc:Loc MountAnimationCreator.MountLink.RiderTag}"/>
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,1"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="DisplayName"
                      ItemContainerStyle="{StaticResource SlotItem}"
                      ToolTip="{loc:Loc MountAnimationCreator.MountLink.RiderTag.ToolTip}"
                      Text="{Binding MountLinkController.SelectedRiderTag.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding MountLinkController.SelectedRiderTag.Values}"
                      SelectedItem="{Binding MountLinkController.SelectedRiderTag.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </Grid>
    </Expander>
</UserControl>
