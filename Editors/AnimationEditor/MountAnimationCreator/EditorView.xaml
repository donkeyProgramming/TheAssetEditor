<UserControl x:Class="AnimationEditor.MountAnimationCreator.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AnimationEditor.MountAnimationCreator"
             xmlns:views="clr-namespace:AnimationEditor.MountAnimationCreator.Views"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="450">

    <UserControl.Resources>
        <!-- Shared by the sub views: text wraps in a narrow panel -->
        <DataTemplate x:Key="WrappingText">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="WrappingTextLeft">
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="ContentTemplate" Value="{StaticResource WrappingText}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="ContentTemplate" Value="{StaticResource WrappingTextLeft}"/>
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Info" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,2,4,4"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <!-- What a disabled button still needs; empty when nothing is missing -->
        <Style x:Key="Status" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,0,4,4"/>
            <Setter Property="Foreground" Value="Orange"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5">
        <TextBlock Text="{loc:Loc MountAnimationCreator.Title}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Style="{StaticResource Info}" Text="{loc:Loc MountAnimationCreator.Intro}"/>

        <TabControl Margin="0,8,0,0" SelectedIndex="{Binding SelectedModeTab.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="{loc:Loc MountAnimationCreator.Tabs.MountChange}" ToolTip="{loc:Loc MountAnimationCreator.Tabs.MountChange.ToolTip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Info}" Text="{loc:Loc MountAnimationCreator.MountChange.Intro}"/>
                    <local:RiderAttachmentSubView/>
                    <views:AnimationSettingsView DataContext="{Binding AnimationSettings, Mode=OneTime}"/>
                    <views:SaveAndPreviewView/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:Loc MountAnimationCreator.Tabs.AttachedMountChange}" ToolTip="{loc:Loc MountAnimationCreator.Tabs.AttachedMountChange.ToolTip}">
                <views:AttachedMountChangeView DataContext="{Binding AttachedMountChange, Mode=OneTime}"/>
            </TabItem>
            <TabItem Header="{loc:Loc MountAnimationCreator.Tabs.AttachConversion}" ToolTip="{loc:Loc MountAnimationCreator.Tabs.AttachConversion.ToolTip}">
                <views:AttachedRiderConversionView DataContext="{Binding AttachedRiders, Mode=OneTime}"/>
            </TabItem>
        </TabControl>

        <views:OutputSettingsView DataContext="{Binding Output, Mode=OneTime}"/>
        <local:VisualisationHelperSubView/>

        <Button Margin="2,10,2,2" Content="{loc:Loc MountAnimationCreator.Buttons.Reset}" ToolTip="{loc:Loc MountAnimationCreator.Buttons.Reset.ToolTip}" Click="{s:MethodBinding ResetTool}"/>
    </StackPanel>
</UserControl>
