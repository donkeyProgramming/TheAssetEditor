<UserControl x:Class="Editors.AnimationMeta.SuperView.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:s="http://schemas.singulink.com/xaml" 
             xmlns:view="clr-namespace:Editors.AnimationMeta.Presentation.View"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:resources="clr-namespace:Shared.EmbeddedResources;assembly=Shared.EmbeddedResources"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ProblemsVisibility"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- One toolbar for the view and the 3D tools. It wraps by group rather than hiding what does not fit in the
             overflow menu, since the side panel is often narrower than the row. -->
        <Border Margin="5" DockPanel.Dock="Top" Padding="2,1,1,1" BorderThickness="1"
                Background="{DynamicResource ToolBarHorizontalBackground}" BorderBrush="{DynamicResource ToolBarHorizontalBorder}">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static ToolBar.CheckBoxStyleKey}}"/>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"/>
                    <Style TargetType="Separator" BasedOn="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                    <!-- A disabled tool's icon fades; the theme leaves an image button looking the same either way. -->
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Resources>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc MetadataEditor.Buttons.Refresh}" Click="{s:MethodBinding RefreshAction}" Padding="8,3"/>
                    <Separator/>
                    <CheckBox Content="{loc:Loc SuperView.ShowVfx}" IsChecked="{Binding ShowVfx, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="4,0"/>
                    <StackPanel Orientation="Horizontal" ToolTip="{loc:Loc SuperView.VfxFilter.Tooltip}" Margin="4,0">
                        <TextBlock Text="{loc:Loc SuperView.VfxFilter}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding VfxFilterIds}" SelectedItem="{Binding VfxFilterId}" MinWidth="50"/>
                    </StackPanel>
                    <Separator/>
                </StackPanel>

                <!-- Editing the selected tag in the 3D view -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="MetaEditTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsSelectTool, Mode=TwoWay}" Padding="6,3" ToolTip="{loc:Loc SuperView.Edit3D.Select}">
                        <Image Width="20" Height="20" Source="{Binding Source={x:Static resources:IconLibrary.Gizmo_CursorIcon}}"/>
                    </RadioButton>
                    <RadioButton GroupName="MetaEditTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsMoveTool, Mode=TwoWay}" Padding="6,3" ToolTip="{loc:Loc SuperView.Edit3D.Move}">
                        <Image Width="20" Height="20" Source="{Binding Source={x:Static resources:IconLibrary.Gizmo_MoveIcon}}"/>
                    </RadioButton>
                    <RadioButton GroupName="MetaEditTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsRotateTool, Mode=TwoWay}" IsEnabled="{Binding CanRotateSelectedIn3D}" Padding="6,3" ToolTip="{loc:Loc SuperView.Edit3D.Rotate}" ToolTipService.ShowOnDisabled="True">
                        <Image Width="20" Height="20" Source="{Binding Source={x:Static resources:IconLibrary.Gizmo_RotateIcon}}"/>
                    </RadioButton>
                    <Separator/>
                    <Button Content="{loc:Loc SuperView.Edit3D.Undo}" Command="{Binding UndoEditIn3DCommand}" Padding="8,3" ToolTip="{loc:Loc SuperView.Edit3D.UndoTooltip}" ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="{loc:Loc SuperView.Edit3D.Redo}" Command="{Binding RedoEditIn3DCommand}" Padding="8,3" ToolTip="{loc:Loc SuperView.Edit3D.RedoTooltip}" ToolTipService.ShowOnDisabled="True"/>
                    <Separator/>
                    <Button Content="{loc:Loc SuperView.Edit3D.Focus}" Command="{Binding FocusSelectedTagCommand}" Padding="8,3" ToolTip="{loc:Loc SuperView.Edit3D.FocusTooltip}" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- What the game supplies while the unit plays, for the preview only -->
        <Expander DockPanel.Dock="Top" Margin="5,0,5,4" IsExpanded="False" Header="{loc:Loc SuperView.EffectPreview.Header}"
                  ToolTip="{loc:Loc SuperView.EffectPreview.Tooltip}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.ColumnSpan="4" Content="{loc:Loc SuperView.EffectPreview.DistanceCulled}" ToolTip="{loc:Loc SuperView.EffectPreview.DistanceCulledTooltip}"
                          IsChecked="{Binding HideDistanceCulledEffects}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Text="{loc:Loc SuperView.EffectPreview.Aura}" ToolTip="{loc:Loc SuperView.EffectPreview.AuraTooltip}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AuraVfx}" ToolTip="{loc:Loc SuperView.EffectPreview.AuraTooltip}" Margin="0,1"/>
                <Button Grid.Row="1" Grid.Column="2" Content="..." Command="{Binding BrowseAuraVfxCommand}" ToolTip="{loc:Loc SuperView.EffectPreview.Browse}" Padding="6,1" Margin="4,1,0,1"/>
                <Button Grid.Row="1" Grid.Column="3" Content="{loc:Loc SuperView.EffectPreview.Clear}" Command="{Binding ClearAuraVfxCommand}" Padding="6,1" Margin="4,1,0,1"/>

                <TextBlock Grid.Row="2" Text="{loc:Loc SuperView.EffectPreview.Weapon}" ToolTip="{loc:Loc SuperView.EffectPreview.WeaponTooltip}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WeaponVfx}" ToolTip="{loc:Loc SuperView.EffectPreview.WeaponTooltip}" Margin="0,1"/>
                <Button Grid.Row="2" Grid.Column="2" Content="..." Command="{Binding BrowseWeaponVfxCommand}" ToolTip="{loc:Loc SuperView.EffectPreview.Browse}" Padding="6,1" Margin="4,1,0,1"/>
                <Button Grid.Row="2" Grid.Column="3" Content="{loc:Loc SuperView.EffectPreview.Clear}" Command="{Binding ClearWeaponVfxCommand}" Padding="6,1" Margin="4,1,0,1"/>
            </Grid>
        </Expander>

        <!-- What is wrong in the two META files; shown only when something is. Clicking a line opens its tag. -->
        <Expander DockPanel.Dock="Bottom" Margin="5,2,5,5" IsExpanded="True" Header="{Binding ProblemsHeader}"
                  ToolTip="{loc:Loc SuperView.Problems.Tooltip}"
                  Visibility="{Binding HasProblems, Converter={StaticResource ProblemsVisibility}}">
            <ListBox ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}" MaxHeight="160"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="IndianRed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding SelectedTabControllerIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
            <TabItem Header="{loc:Loc MetadataEditor.Tabs.Persistent}">
                <DockPanel>
                    <!-- The slot names a META file that is not in any loaded pack, or names none -->
                    <Border DockPanel.Dock="Top" Margin="4" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource ToolBarHorizontalBorder}"
                            Visibility="{Binding CanCreatePersistentMetaFile, Converter={StaticResource ProblemsVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SuperView.MissingMeta.NotInPacks}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding PersistentMetaFilePath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <Button Content="{loc:Loc SuperView.MissingMeta.Create}" ToolTip="{loc:Loc SuperView.MissingMeta.CreateTooltip}"
                                    Click="{s:MethodBinding CreatePersistentMetaFile}" HorizontalAlignment="Left" Padding="8,3"/>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="6" TextWrapping="Wrap" Text="{loc:Loc SuperView.MissingMeta.NotNamedPersistent}"
                               Visibility="{Binding IsPersistentMetaFileNotNamed, Converter={StaticResource ProblemsVisibility}}"/>
                    <view:MainEditorView DataContext="{Binding PersistentMetaEditor}" DockPanel.Dock="Top"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="{loc:Loc MetadataEditor.Tabs.Animation}">
                <DockPanel>
                    <!-- The slot names a META file that is not in any loaded pack, or names none -->
                    <Border DockPanel.Dock="Top" Margin="4" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource ToolBarHorizontalBorder}"
                            Visibility="{Binding CanCreateAnimationMetaFile, Converter={StaticResource ProblemsVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SuperView.MissingMeta.NotInPacks}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding AnimationMetaFilePath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <Button Content="{loc:Loc SuperView.MissingMeta.Create}" ToolTip="{loc:Loc SuperView.MissingMeta.CreateTooltip}"
                                    Click="{s:MethodBinding CreateAnimationMetaFile}" HorizontalAlignment="Left" Padding="8,3"/>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="6" TextWrapping="Wrap" Text="{loc:Loc SuperView.MissingMeta.NotNamedAnimation}"
                               Visibility="{Binding IsAnimationMetaFileNotNamed, Converter={StaticResource ProblemsVisibility}}"/>
                    <view:MainEditorView DataContext="{Binding MetaEditor}" DockPanel.Dock="Top"/>
                </DockPanel>
            </TabItem>
        </TabControl>
        
        
    </DockPanel>
</UserControl>
