<UserControl x:Class="AnimationEditor.Common.ReferenceModel.SceneObjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.singulink.com/xaml"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" d:DesignWidth="800">

    <Expander IsExpanded="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
              IsEnabled="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
              Visibility="{Binding IsControlVisible, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToCollapsedConverter}}" Margin="10,0,0,0">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ToolTip="{loc:Loc ReferenceModel.SceneObject.ShowAll.ToolTip}"/>
                <TextBlock VerticalAlignment="Center">
                        <Run FontSize="14" FontWeight="Bold"  Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
                        <Run Text="{Binding SubHeaderName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Expander.Header>

        <!-- One grid, so the fields and buttons of every row line up -->
        <Grid Margin="5,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="74"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="4,1,0,1"/>
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Margin" Value="0,1"/>
                </Style>
            </Grid.Resources>

            <!-- Mesh -->
            <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Data.ShowMesh.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ToolTip="{loc:Loc ReferenceModel.SceneObject.ShowMesh.ToolTip}"/>
            <Label Grid.Row="0" Grid.Column="1" Content="{loc:Loc ReferenceModel.SceneObject.Mesh}"/>
            <Label Grid.Row="0" Grid.Column="2" Content=":"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Data.MeshName.Value, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            <Button Grid.Row="0" Grid.Column="4" Content="{loc:Loc ReferenceModel.SceneObject.Browse}" ToolTip="{loc:Loc ReferenceModel.SceneObject.BrowseMesh.ToolTip}" Click="{s:MethodBinding BrowseMesh}"/>

            <!-- Skeleton -->
            <CheckBox Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" IsChecked="{Binding Data.ShowSkeleton.Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ToolTip="{loc:Loc ReferenceModel.SceneObject.ShowSkeleton.ToolTip}"/>
            <Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Content="{loc:Loc ReferenceModel.SceneObject.Skeleton}"/>
            <Label Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Content=":"/>
            <Expander Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,4,0,0" IsExpanded="False" Header="{Binding Data.SkeletonName.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc ReferenceModel.SceneObject.Skeleton.ToolTip}">
                <TreeView ItemsSource="{Binding SkeletonInformation.Bones, UpdateSourceTrigger=PropertyChanged}" MaxHeight="400">
                    <b:Interaction.Behaviors>
                        <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SkeletonInformation.SelectedBone, Mode=TwoWay}" />
                    </b:Interaction.Behaviors>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate >
                        <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BoneName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text=" - "></TextBlock>
                                <TextBlock Text="{Binding BoneIndex, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Expander>

            <Rectangle Grid.Row="2" Grid.ColumnSpan="5" Fill="LightGray" Height="1" Margin="2,4,2,4"/>

            <!-- Fragment and slot -->
            <Label Grid.Row="3" Grid.Column="1" Content="{loc:Loc ReferenceModel.SceneObject.Fragment}"/>
            <Label Grid.Row="3" Grid.Column="2" Content=":"/>
            <ComboBox Grid.Row="3" Grid.Column="3"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="FileName"
                      ToolTip="{loc:Loc ReferenceModel.SceneObject.Fragment.ToolTip}"
                      Text="{Binding FragAndSlotSelection.FragmentList.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding FragAndSlotSelection.FragmentList.Values}"
                      SelectedItem="{Binding FragAndSlotSelection.FragmentList.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button Grid.Row="3" Grid.Column="4" Content="{loc:Loc ReferenceModel.SceneObject.Open}" ToolTip="{loc:Loc ReferenceModel.SceneObject.OpenFragment.ToolTip}" Click="{s:MethodBinding ViewFragment}"/>

            <Label Grid.Row="4" Grid.Column="1" Content="{loc:Loc ReferenceModel.SceneObject.Slot}"/>
            <Label Grid.Row="4" Grid.Column="2" Content=":"/>
            <ComboBox Grid.Row="4" Grid.Column="3"
                      IsEditable="True"
                      IsTextSearchEnabled="false"
                      DisplayMemberPath="SlotName"
                      ToolTip="{loc:Loc ReferenceModel.SceneObject.Slot.ToolTip}"
                      Text="{Binding FragAndSlotSelection.FragmentSlotList.Filter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      ItemsSource="{Binding FragAndSlotSelection.FragmentSlotList.Values}"
                      SelectedItem="{Binding FragAndSlotSelection.FragmentSlotList.SelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <Rectangle Grid.Row="5" Grid.ColumnSpan="5" Fill="LightGray" Height="1" Margin="2,4,2,4"/>

            <!-- What is loaded -->
            <Label Grid.Row="6" Grid.Column="1" Content="{loc:Loc ReferenceModel.SceneObject.AnimationFile}"/>
            <Label Grid.Row="6" Grid.Column="2" Content=":"/>
            <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding FragAndSlotSelection.AnimationFileName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            <Button Grid.Row="6" Grid.Column="4" Content="{loc:Loc ReferenceModel.SceneObject.Browse}" ToolTip="{loc:Loc ReferenceModel.SceneObject.BrowseAnimation.ToolTip}" Click="{s:MethodBinding BrowseAnimation}"/>

            <Label Grid.Row="7" Grid.Column="1" Content="{loc:Loc ReferenceModel.SceneObject.MetaFile}"/>
            <Label Grid.Row="7" Grid.Column="2" Content=":"/>
            <TextBox Grid.Row="7" Grid.Column="3" Text="{Binding FragAndSlotSelection.MetaDataName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" ToolTip="{loc:Loc ReferenceModel.SceneObject.MetaFile.ToolTip}"/>

            <Label Grid.Row="8" Grid.Column="1" Content="{loc:Loc ReferenceModel.SceneObject.PersistMetaFile}"/>
            <Label Grid.Row="8" Grid.Column="2" Content=":"/>
            <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding FragAndSlotSelection.MetaDataPersistName, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" ToolTip="{loc:Loc ReferenceModel.SceneObject.PersistMetaFile.ToolTip}"/>
        </Grid>
    </Expander>
</UserControl>
